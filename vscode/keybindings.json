[
    // === Tool Windows ===
    {
        "key": "cmd+1", // Explorer — закрыть, если уже открыт
        "command": "workbench.action.toggleSidebarVisibility",
        "when": "activeViewlet == 'workbench.view.explorer' && sideBarVisible"
    },
    {
        "key": "cmd+1", // Explorer — открыть
        "command": "workbench.view.explorer",
        "when": "activeViewlet != 'workbench.view.explorer' || !sideBarVisible"
    },

    {
        "key": "cmd+2", // DBCode — закрыть, если уже открыт
        "command": "workbench.action.toggleSidebarVisibility",
        "when": "view.dbcode.connections.view.visible && sideBarVisible"
    },
    {
        "key": "cmd+2", // DBCode — открыть
        "command": "dbcode.connections.view.focus",
        "when": "!view.dbcode.connections.view.visible || !sideBarVisible"
    },

    {
        "key": "cmd+3", // Git Changes — закрыть, если уже открыт
        "command": "workbench.action.toggleSidebarVisibility",
        "when": "activeViewlet == 'workbench.view.scm' && sideBarVisible"
    },
    {
        "key": "cmd+3", // Git Changes — открыть
        "command": "workbench.view.scm",
        "when": "activeViewlet != 'workbench.view.scm' || !sideBarVisible"
    },
    {
        "key": "cmd+4", // Git Graph — закрыть
        "command": "workbench.action.closeActiveEditor",
        "when": "activeWebviewPanelId == 'git-graph'"
    },
    {
        "key": "cmd+4", // Git Graph — открыть
        "command": "git-graph.view",
        "when": "activeWebviewPanelId != 'git-graph'"
    },
    {
        "key": "cmd+e", // Открыть недавние файлы
        "command": "workbench.action.quickOpenPreviousRecentlyUsedEditorInGroup"
    },
    {
        "key": "cmd+[", // Назад по истории навигации
        "command": "workbench.action.navigateBack"
    },
    {
        "key": "shift+cmd+c", // Абсолютный путь к файлу
        "command": "copyFilePath"
    },
    {
        "key": "shift+alt+cmd+c", // Относительный путь + номер строки
        "command": "copyFilePathWithLineNumbers.copyRelativeReference",
        "when": "editorTextFocus"
    },
    {
        "key": "cmd+]", // Вперёд по истории навигации
        "command": "workbench.action.navigateForward"
    },
    {
        "key": "cmd+backspace", // Удалить текущую строку
        "command": "editor.action.deleteLines",
        "when": "textInputFocus && !editorReadonly"
    },
    {
        "key": "cmd+1", // Открыть панель файлов
        "command": "workbench.view.explorer",
        "when": "!explorerViewletVisible"
    },
    {
        "key": "cmd+1", // Закрыть панель файлов
        "command": "workbench.action.toggleSidebarVisibility",
        "when": "explorerViewletVisible"
    },
    {
        "key": "cmd+[IntlBackslash]", // Cmd + § — открыть / закрыть терминал
        "command": "workbench.action.terminal.toggleTerminal"
    },
    {
        "key": "cmd+b", // Go to Definition
        "command": "editor.action.revealDefinition",
        "when": "editorHasDefinitionProvider && editorTextFocus"
    },
    {
        "key": "cmd+alt+b", // Go to Implementation
        "command": "editor.action.goToImplementation",
        "when": "editorHasImplementationProvider && editorTextFocus"
    },
    {
        "key": "cmd+w", // Закрыть активный editor
        "command": "workbench.action.closeActiveEditor"
    },
    {
        "key": "cmd+shift+[", // Свернуть текущий блок кода
        "command": "editor.fold",
        "when": "editorTextFocus && foldingEnabled"
    },
    {
        "key": "cmd+shift+]", // Развернуть текущий блок кода
        "command": "editor.unfold",
        "when": "editorTextFocus && foldingEnabled"
    },
    {
        "key": "alt+backspace", // Удалить предыдущее слово во встроенном терминале
        "command": "workbench.action.terminal.sendSequence",
        "args": {
            "text": "\u0017"
        },
        "when": "terminalFocus"
    }
]
